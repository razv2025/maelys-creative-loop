  "moduleLearnings": [
    {
      "id": "AB-2026-03",
      "module": "sticky_atc",
      "test": "Sticky add-to-cart bar on listicle vs none (2026-03)",
      "finding": "Collapsible sticky ATC bar lifted ATC +9% on pages ≥10 sections with no CVR downside.",
      "effect": "+9% ATC",
      "appliesTo": ["advertorial", "listicle-creator", "exploratory-story"],
      "directive": "Always include a sticky ATC bar on long pages."
    },
    {
      "id": "AB-2026-07",
      "module": "stats_before_offer",
      "test": "Clinical stats block placed before vs after first offer widget (2026-04)",
      "finding": "Showing the 90/83/80 clinical tiles BEFORE the first offer lifted CVR +12% for cold (problem-aware) traffic; no effect for retargeting.",
      "effect": "+12% CVR (cold traffic)",
      "appliesTo": ["advertorial", "listicle-creator"],
      "directive": "Order sections so clinical proof precedes the first offer block for cold traffic."
    },
    {
      "id": "AB-2026-11",
      "module": "single_price_frame",
      "test": "'$5 shipping today' single frame vs '$0' + strikethrough mix (2026-05)",
      "finding": "One consistent price frame ('Try it for $5 shipping · 3 full weeks') matched CVR (-0.4%, n.s.) and cut 90-day refund rate by 18% relative.",
      "effect": "-18% refunds, CVR neutral",
      "appliesTo": ["advertorial", "advertorial-compact", "listicle-creator", "exploratory-story"],
      "directive": "Use the single '$5 shipping today' price frame; avoid mixing $0/$5/$43.20 in one viewport."
    },
    {
      "id": "AB-2026-14",
      "module": "creator_depth",
      "test": "Deep creator personalization (quotes woven into body) vs headline-only swap (2026-06)",
      "finding": "For creator-ad traffic, pages with ≥4 creator quotes below the fold had +14% engaged scroll and +8% ATC vs headline-only personalization.",
      "effect": "+8% ATC (creator traffic)",
      "appliesTo": ["listicle-creator"],
      "directive": "When the ad has a creator, weave their voice through the whole page, not just the H1."
    },
    {
      "id": "AB-2026-16",
      "module": "press_bar_position",
      "test": "Press logo bar above vs below before/afters (2026-06)",
      "finding": "Press bar position had no measurable effect; before/afters above the fold beat press-first layouts on engaged scroll +6%.",
      "effect": "+6% engaged scroll (B/A first)",
      "appliesTo": ["advertorial"],
      "directive": "Lead with before/after proof; keep press logos secondary."
    },
    {
      "id": "AB-2026-19",
      "module": "faq_objection_order",
      "test": "FAQ ordered by GA4 exit-intent objections vs generic order (2026-07)",
      "finding": "Opening the FAQ with the top pre-purchase objection measured in GA4 ('When will I be charged?') lifted CVR +4% on mobile.",
